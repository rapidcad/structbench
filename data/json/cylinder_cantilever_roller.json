{
  "meta": {
    "problem_id": "CYLINDER_CANTILEVER_ROLLER",
    "description": "Cylindrical cantilever beam (axis along y). Left end fully fixed, right end has a vertical roller (z free, x+y locked). Distributed downward load at mid-span. Roller relieves vertical reaction at far end.",
    "analysis_type": "3d"
  },
  "design_domain": {
    "units": "mm",
    "shape_type": "cylinder",
    "params": {
      "radius": 20,
      "height": 100,
      "center": [0, 0, 0],
      "axis": "y"
    }
  },
  "spatial_selectors": [
    {
      "id": "fixed_end",
      "type": "box_3d",
      "query": {
        "x_min": -20, "x_max": 20,
        "y_min": -0.5, "y_max": 0.5,
        "z_min": -20, "z_max": 20
      }
    },
    {
      "id": "roller_end",
      "type": "box_3d",
      "query": {
        "x_min": -20, "x_max": 20,
        "y_min": 99, "y_max": 100.5,
        "z_min": -20, "z_max": 20
      }
    },
    {
      "id": "midspan_top",
      "type": "box_3d",
      "query": {
        "x_min": -4, "x_max": 4,
        "y_min": 40, "y_max": 60,
        "z_min": 18, "z_max": 22
      }
    }
  ],
  "boundary_conditions": [
    {
      "name": "fix_left",
      "region_id": "fixed_end",
      "type": "fixed_displacement",
      "dof_lock": {"x": true, "y": true, "z": true}
    },
    {
      "name": "roller_right",
      "region_id": "roller_end",
      "type": "fixed_displacement",
      "dof_lock": {"x": true, "y": true, "z": false}
    }
  ],
  "loads": [
    {
      "name": "midspan_load",
      "region_id": "midspan_top",
      "type": "distributed_force",
      "direction": "-z",
      "magnitude_newtons": 5000.0
    }
  ],
  "material": {
    "type": "isotropic",
    "elastic_modulus_mpa": 210000,
    "poissons_ratio": 0.3,
    "density_g_cm3": 7.85
  }
}
